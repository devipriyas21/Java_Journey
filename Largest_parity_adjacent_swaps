
import java.util.*;

class Solution {
    public ArrayList<Integer> lexicographicallyLargest(int[] arr) {
        ArrayList<Integer> result = new ArrayList<>();

        int n = arr.length;
        int i = 0;

        while (i < n) {
            int j = i;

            // Find the continuous group with the same parity
            while (j + 1 < n &&
                   arr[j] % 2 == arr[j + 1] % 2) {
                j++;
            }

            // Sort this group in descending order
            Integer[] group = new Integer[j - i + 1];

            for (int k = i; k <= j; k++) {
                group[k - i] = arr[k];
            }

            Arrays.sort(group, Collections.reverseOrder());

            for (int num : group) {
                result.add(num);
            }

            i = j + 1;
        }

        return result;
    }
}
